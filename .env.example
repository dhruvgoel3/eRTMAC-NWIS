# ─── eRTMAC-NWIS Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit a .env file with real credentials.

# ─── Supabase PostgreSQL Database ────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → Database
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ─── Supabase API (for Auth and Storage) ─────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# ─── OpenAI API (optional — system works in demo mode without it) ─────────────
# Get from: https://platform.openai.com/api-keys
# Leave blank to use the built-in DemoAIProvider (no API calls made)
OPENAI_API_KEY=

# ─── AI Model ─────────────────────────────────────────────────────────────────
AI_MODEL=gpt-4o-mini

# ─── Application URLs ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ─── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production

# ─── Simulation ───────────────────────────────────────────────────────────────
# How often the real-time simulation ticks (in seconds)
SIMULATION_TICK_SECONDS=1

# ─── Data Ingestion (optional overrides) ─────────────────────────────────────
# Set to 1 to skip database loading and only produce flat-files
INGESTION_SKIP_DB=0
