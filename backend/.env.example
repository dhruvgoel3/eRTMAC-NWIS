# Supabase Database & Auth (Backend-Only)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenAI & Domain RAG
OPENAI_API_KEY=your-openai-api-key
AI_MODEL=gpt-4o-mini

# Service URLs & Security
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
SECRET_KEY=your-jwt-secret-key-change-in-production

# Carto Basemaps API (Proxied through backend /api/map/tile/... — never exposed on frontend)
CARTO_API_KEY=your-carto-api-key
CARTO_STYLE=dark_all

# Telemetry & Ingestion Controls
SIMULATION_TICK_SECONDS=1
INGESTION_SKIP_DB=false
